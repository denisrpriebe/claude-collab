#!/bin/bash
# Collab CLI. Message text is read from stdin so it never needs shell quoting:
#   collab ask dwight <<'EOF'
#   Is the zero-tax fallback in InvoiceTotals intended?
#   EOF
set -euo pipefail
# The team's relay. Replace when it's deployed.
default_url="https://collab.example.com"
dir="${COLLAB_DIR:-$HOME/.claude/collab}"
session="${CLAUDE_CODE_SESSION_ID:-none}"

relay_url() {
    cat "$dir/url" 2>/dev/null || echo "$default_url"
}

call() {
    local method=$1 path=$2
    shift 2
    curl -sS -X "$method" -H "Authorization: Bearer $(cat "$dir/token")" "$(relay_url)$path" "$@"
}

case "${1:-}" in
    setup)
        mkdir -p "$dir"
        printf '%s' "$2" > "$dir/token"
        chmod 600 "$dir/token"
        # Only needed to point at a relay other than the team's.
        if [ -n "${3:-}" ]; then printf '%s' "$3" > "$dir/url"; fi
        call GET /me
        ;;
    url) relay_url ;;
    who) call GET /who ;;
    online)
        # Remembered so the listener can reclaim the spot if the relay restarts.
        result=$(call POST "/online?session=$session")
        echo "$result"
        [[ $result == online:* ]] && mkdir -p "$dir/online" && touch "$dir/online/$session"
        ;;
    offline)
        rm -f "$dir/online/$session"
        call POST "/offline?session=$session"
        ;;
    ask) call POST "/ask?to=$2&session=$session" --data-binary @- ;;
    reply) call POST "/reply?id=$2&session=$session&status=${3:-}" --data-binary @- ;;
    thread) call GET "/thread?id=$2" ;;
    *)
        echo "usage: collab setup <token> [url] | url | who | online | offline | ask <person> | reply <id> [escalated] | thread <id>"
        exit 1
        ;;
esac
